# --- required -------------------------------------------------------------
# Discord Developer Portal -> your app -> Bot -> Reset Token -> copy. Never share it.
DISCORD_TOKEN=

# --- optional -------------------------------------------------------------
# Your Discord server ID: slash commands appear there instantly while testing.
# (Right-click the server icon -> Copy Server ID; turn on Developer Mode first.)
# Leave empty to register commands everywhere (can take a little while the first time).
DEV_GUILD_ID=

# Only these Discord user IDs may use the bot (comma separated). Empty = any server admin.
ARCHITECT_OWNER_IDS=

# --- planner ----------------------------------------------------------------
# ollama  = free local AI on this PC (default)  |  openai = any OpenAI-compatible endpoint
# none    = no AI, built-in keyword planner only (always works, instant)
ARCHITECT_LLM=ollama
OLLAMA_URL=http://localhost:11434
# 8 GB graphics card: qwen2.5:7b  ·  weaker PC: qwen2.5:3b or llama3.2:3b
OLLAMA_MODEL=qwen2.5:7b

# Only for ARCHITECT_LLM=openai (a free tier works, e.g. Groq or Google AI Studio):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120

# --- tuning -------------------------------------------------------------------
# Operations per batch and the pause between batches (seconds). Raise the pause if Discord
# rate-limits a big build.
ARCHITECT_BATCH_SIZE=5
ARCHITECT_BATCH_PAUSE=1.0
LOG_LEVEL=INFO
